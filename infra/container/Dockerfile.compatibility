# Temporary, staging-only bridge from the exact currently running immutable image.
# The release workflow resolves this from the stable live ECS service and verifies it
# again before the bridge is eligible for migration.
ARG PREVIOUS_IMAGE
FROM ${PREVIOUS_IMAGE}
COPY --chmod=0555 backend/scripts/release/compatibility_bridge.py /opt/buddy/compatibility_bridge.py
CMD ["python", "/opt/buddy/compatibility_bridge.py"]
