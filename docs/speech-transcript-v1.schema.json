{
  "additionalProperties": false,
  "description": "Provider-independent v1 contract; partial updates share their segment ID.",
  "properties": {
    "type": {
      "const": "transcript",
      "default": "transcript",
      "title": "Type",
      "type": "string"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "stream_id": {
      "format": "uuid",
      "title": "Stream Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "segment_id": {
      "title": "Segment Id",
      "type": "string"
    },
    "final": {
      "title": "Final",
      "type": "boolean"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "start_seconds": {
      "minimum": 0,
      "title": "Start Seconds",
      "type": "number"
    },
    "end_seconds": {
      "minimum": 0,
      "title": "End Seconds",
      "type": "number"
    },
    "capture_end_ns": {
      "exclusiveMinimum": 0,
      "title": "Capture End Ns",
      "type": "integer"
    }
  },
  "required": [
    "session_id",
    "stream_id",
    "sequence",
    "segment_id",
    "final",
    "text",
    "start_seconds",
    "end_seconds",
    "capture_end_ns"
  ],
  "title": "TranscriptEvent",
  "type": "object"
}
