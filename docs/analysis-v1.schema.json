{
  "$defs": {
    "ActionGrounding": {
      "additionalProperties": false,
      "properties": {
        "action_sha256": {
          "$ref": "#/$defs/Digest"
        },
        "instance_id": {
          "$ref": "#/$defs/Identifier"
        },
        "trace": {
          "$ref": "#/$defs/GroundingTrace"
        }
      },
      "required": [
        "instance_id",
        "action_sha256",
        "trace"
      ],
      "title": "ActionGrounding",
      "type": "object"
    },
    "ContentAction": {
      "additionalProperties": false,
      "properties": {
        "deck_id": {
          "$ref": "#/$defs/Identifier"
        },
        "instance_id": {
          "$ref": "#/$defs/Identifier"
        },
        "params": {
          "$ref": "#/$defs/RegionParameters"
        },
        "purpose": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Purpose",
          "type": "string"
        },
        "render_id": {
          "$ref": "#/$defs/Identifier"
        },
        "slide_id": {
          "$ref": "#/$defs/Identifier"
        },
        "type": {
          "enum": [
            "zoom_region",
            "highlight_region"
          ],
          "title": "Type",
          "type": "string"
        },
        "version": {
          "const": "1.1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "instance_id",
        "purpose",
        "deck_id",
        "render_id",
        "slide_id",
        "type",
        "params"
      ],
      "title": "ContentAction",
      "type": "object"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "GroundingMethod": {
      "enum": [
        "pdf_glyphs",
        "pdf_words",
        "ocr_words",
        "pdf_visual_geometry",
        "visual_hint",
        "pdf_candidate_line"
      ],
      "type": "string"
    },
    "GroundingTrace": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/$defs/GroundingMethod"
        },
        "model_region": {
          "$ref": "#/$defs/Region"
        },
        "resolved_region": {
          "$ref": "#/$defs/Region"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "target_text": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Text"
        },
        "version": {
          "const": "pdf-source-grounding-1",
          "default": "pdf-source-grounding-1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "method",
        "target_text",
        "model_region",
        "resolved_region"
      ],
      "title": "GroundingTrace",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "Manifest": {
      "additionalProperties": false,
      "properties": {
        "deck_id": {
          "$ref": "#/$defs/Identifier"
        },
        "render_id": {
          "$ref": "#/$defs/Identifier"
        },
        "slides": {
          "items": {
            "$ref": "#/$defs/ManifestSlide"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Slides",
          "type": "array"
        },
        "version": {
          "const": "1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "deck_id",
        "render_id",
        "slides"
      ],
      "title": "Manifest",
      "type": "object"
    },
    "ManifestSlide": {
      "additionalProperties": false,
      "properties": {
        "raster": {
          "$ref": "#/$defs/Raster"
        },
        "slide_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source": {
          "$ref": "#/$defs/SourcePlane"
        }
      },
      "required": [
        "slide_id",
        "source",
        "raster"
      ],
      "title": "ManifestSlide",
      "type": "object"
    },
    "Raster": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "path": {
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.png$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "transform": {
          "const": "scale",
          "title": "Transform",
          "type": "string"
        },
        "width": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "width",
        "height",
        "transform",
        "sha256"
      ],
      "title": "Raster",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Region",
      "type": "object"
    },
    "RegionParameters": {
      "additionalProperties": false,
      "properties": {
        "region": {
          "$ref": "#/$defs/Region"
        }
      },
      "required": [
        "region"
      ],
      "title": "RegionParameters",
      "type": "object"
    },
    "SlideOutput": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContentAction"
          },
          "maxItems": 100,
          "title": "Actions",
          "type": "array"
        },
        "slide_id": {
          "$ref": "#/$defs/Identifier"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        }
      },
      "required": [
        "slide_id",
        "summary"
      ],
      "title": "SlideOutput",
      "type": "object"
    },
    "SourcePlane": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "origin": {
          "const": "top_left",
          "title": "Origin",
          "type": "string"
        },
        "units": {
          "const": "source_pixels",
          "title": "Units",
          "type": "string"
        },
        "width": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "units",
        "origin"
      ],
      "title": "SourcePlane",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "pending",
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "title": "Summary",
      "type": "object"
    },
    "Text": {
      "maxLength": 16000,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Catalog Version",
      "type": "string"
    },
    "display_profile": {
      "$ref": "#/$defs/Identifier"
    },
    "extraction_id": {
      "format": "uuid",
      "title": "Extraction Id",
      "type": "string"
    },
    "extraction_schema_version": {
      "const": "buddy.extraction.v1",
      "default": "buddy.extraction.v1",
      "title": "Extraction Schema Version",
      "type": "string"
    },
    "extractor_version": {
      "const": "1",
      "default": "1",
      "title": "Extractor Version",
      "type": "string"
    },
    "grounding": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ActionGrounding"
      },
      "maxItems": 40,
      "title": "Grounding",
      "type": "array"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "manifest": {
      "$ref": "#/$defs/Manifest"
    },
    "presentation_summary": {
      "$ref": "#/$defs/Summary"
    },
    "renderer_version": {
      "$ref": "#/$defs/Identifier"
    },
    "schema_version": {
      "const": "buddy.analysis.v1",
      "default": "buddy.analysis.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "slides": {
      "items": {
        "$ref": "#/$defs/SlideOutput"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Slides",
      "type": "array"
    },
    "source_revision": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Source Revision",
      "type": "string"
    },
    "source_sha256": {
      "$ref": "#/$defs/Digest"
    },
    "validator_version": {
      "$ref": "#/$defs/Identifier"
    }
  },
  "required": [
    "extraction_id",
    "source_revision",
    "source_sha256",
    "job_id",
    "renderer_version",
    "display_profile",
    "validator_version",
    "manifest",
    "presentation_summary",
    "slides"
  ],
  "title": "AnalysisInput",
  "type": "object"
}
